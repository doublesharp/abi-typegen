{
  "name": "@0xdoublesharp/hardhat-abi-typegen",
  "version": "0.3.1",
  "description": "Hardhat plugin for abi-typegen — auto-generate typed bindings on compile",
  "license": "MIT",
  "type": "module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./hardhat2": {
      "types": "./type-extensions.d.ts",
      "import": "./index.cjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doublesharp/abi-typegen",
    "directory": "npm/hardhat-abi-typegen"
  },
  "keywords": [
    "solidity",
    "abi",
    "codegen",
    "typescript",
    "ethereum",
    "hardhat",
    "hardhat-plugin",
    "viem",
    "ethers",
    "wagmi",
    "web3",
    "zod",
    "smart-contracts",
    "typegen",
    "typechain"
  ],
  "files": [
    "config-hooks.js",
    "index.d.ts",
    "index.js",
    "index.cjs",
    "solidity-hooks.js",
    "type-extensions.d.ts",
    "README.md"
  ],
  "dependencies": {
    "@0xdoublesharp/abi-typegen": "^0.3.1"
  },
  "peerDependencies": {
    "hardhat": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "hardhat": {
      "optional": true
    }
  }
}
