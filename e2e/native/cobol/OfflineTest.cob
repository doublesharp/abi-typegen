*> Exercise generated COBOL entry points against the real ABI runtime.
IDENTIFICATION DIVISION.
PROGRAM-ID. COBOL-OFFLINE-TEST.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-OWNER                  PIC X(42)
    VALUE "0x0000000000000000000000000000000000000001".
01  WS-CALLDATA               PIC X(4096).
01  WS-CALLDATA-LEN           PIC 9(9) COMP-5 VALUE 0.
01  WS-RESULT                 PIC X(4096).
01  WS-RESULT-LEN             PIC 9(9) COMP-5 VALUE 0.
01  WS-DECIMAL                PIC X(78).
01  WS-DECIMAL-LEN            PIC 9(9) COMP-5 VALUE 0.
01  WS-ERROR                  PIC X(512).
01  WS-STATUS                 PIC S9(9) COMP-5 VALUE 0.

PROCEDURE DIVISION.
    CALL "TOKEN-BALANCE-OF-ENC" USING
        WS-OWNER WS-CALLDATA WS-CALLDATA-LEN WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS NOT = 0 OR WS-CALLDATA-LEN NOT = 36
        DISPLAY "calldata encode failed: " WS-ERROR
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF
    IF FUNCTION ORD(WS-CALLDATA(1:1)) NOT = 113
        OR FUNCTION ORD(WS-CALLDATA(2:1)) NOT = 161
        OR FUNCTION ORD(WS-CALLDATA(3:1)) NOT = 131
        OR FUNCTION ORD(WS-CALLDATA(4:1)) NOT = 50
        OR WS-CALLDATA(5:31) NOT = LOW-VALUES
        OR WS-CALLDATA(36:1) NOT = X"01"
        DISPLAY "incorrect balanceOf calldata"
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE "G" TO WS-OWNER(42:1)
    CALL "TOKEN-BALANCE-OF-ENC" USING
        WS-OWNER WS-CALLDATA WS-CALLDATA-LEN WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS = 0 OR WS-CALLDATA-LEN NOT = 0
        DISPLAY "invalid address was accepted"
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE LOW-VALUES TO WS-RESULT
    MOVE 32 TO WS-RESULT-LEN
    CALL "TOKEN-BALANCE-OF-DEC" USING
        WS-RESULT WS-RESULT-LEN WS-DECIMAL WS-DECIMAL-LEN
        WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS NOT = 0 OR WS-DECIMAL-LEN NOT = 1
        OR WS-DECIMAL(1:1) NOT = "0"
        DISPLAY "zero decode failed: " WS-ERROR
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE X"01" TO WS-RESULT(16:1)
    CALL "TOKEN-BALANCE-OF-DEC" USING
        WS-RESULT WS-RESULT-LEN WS-DECIMAL WS-DECIMAL-LEN
        WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS NOT = 0 OR WS-DECIMAL-LEN NOT = 39
        OR WS-DECIMAL(1:39) NOT =
            "340282366920938463463374607431768211456"
        DISPLAY "2^128 decode failed: " WS-ERROR
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE ALL X"FF" TO WS-RESULT
    CALL "TOKEN-BALANCE-OF-DEC" USING
        WS-RESULT WS-RESULT-LEN WS-DECIMAL WS-DECIMAL-LEN
        WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS NOT = 0 OR WS-DECIMAL-LEN NOT = 78
        OR WS-DECIMAL(1:78) NOT =
            "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        DISPLAY "uint256 max decode failed: " WS-ERROR
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE LOW-VALUES TO WS-RESULT
    MOVE 33 TO WS-RESULT-LEN
    CALL "TOKEN-BALANCE-OF-DEC" USING
        WS-RESULT WS-RESULT-LEN WS-DECIMAL WS-DECIMAL-LEN
        WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS = 0 OR WS-DECIMAL-LEN NOT = 0
        DISPLAY "noncanonical trailing data was accepted"
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    MOVE 4097 TO WS-RESULT-LEN
    CALL "TOKEN-BALANCE-OF-DEC" USING
        WS-RESULT WS-RESULT-LEN WS-DECIMAL WS-DECIMAL-LEN
        WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS = 0 OR WS-DECIMAL-LEN NOT = 0
        DISPLAY "oversized COBOL decode length was accepted"
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    DISPLAY "COBOL offline bindings passed"
    MOVE 0 TO RETURN-CODE
    GOBACK.
END PROGRAM COBOL-OFFLINE-TEST.
