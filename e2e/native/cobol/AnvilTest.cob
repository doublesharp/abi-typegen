*> Read a known minted balance through generated COBOL and C bridge code.
IDENTIFICATION DIVISION.
PROGRAM-ID. COBOL-ANVIL-TEST.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-RPC-URL                PIC X(256).
01  WS-TOKEN                  PIC X(42).
01  WS-OWNER                  PIC X(42)
    VALUE "0x0000000000000000000000000000000000000001".
01  WS-BALANCE                PIC X(78).
01  WS-BALANCE-LEN            PIC 9(9) COMP-5 VALUE 0.
01  WS-ERROR                  PIC X(512).
01  WS-STATUS                 PIC S9(9) COMP-5 VALUE 0.

PROCEDURE DIVISION.
    ACCEPT WS-RPC-URL FROM ENVIRONMENT "ATG_RPC_URL"
    ACCEPT WS-TOKEN FROM ENVIRONMENT "ATG_TOKEN_ADDRESS"
    IF WS-RPC-URL = SPACES OR WS-TOKEN = SPACES
        DISPLAY "Anvil environment is missing"
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF

    CALL "TOKEN-BALANCE-OF-CALL" USING
        WS-RPC-URL WS-TOKEN WS-OWNER WS-BALANCE
        WS-BALANCE-LEN WS-ERROR WS-STATUS
    END-CALL
    IF WS-STATUS NOT = 0 OR WS-BALANCE-LEN NOT = 39
        OR WS-BALANCE(1:39) NOT =
            "340282366920938463463374607431768211456"
        DISPLAY "Anvil balance mismatch: " WS-ERROR
        MOVE 1 TO RETURN-CODE
        GOBACK
    END-IF
    DISPLAY "COBOL Anvil balance passed"
    MOVE 0 TO RETURN-CODE
    GOBACK.
END PROGRAM COBOL-ANVIL-TEST.
