# Source this only after replacing every placeholder with paths from the real abi-typegen checkout.
export ATG_RUNTIME_INCLUDE=/absolute/path/to/directory/containing/abi_typegen.h
export ATG_RUNTIME_LIB=/absolute/path/to/<runtime-library>.a
# Optional; leave empty unless the runtime's build documentation requires native linker flags.
export ATG_RUNTIME_LINK_FLAGS=''
